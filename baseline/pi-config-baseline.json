{
  "schemaVersion": 2,
  "recommendedPiVersion": "0.99.2",
  "toolConfiguration": {
    "codemode": {
      "mode": "only"
    },
    "profiles": {
      "windows-native": "baseline/platforms/windows-native.settings.json",
      "linux": "baseline/platforms/linux-wsl.settings.json",
      "wsl": "baseline/platforms/linux-wsl.settings.json"
    },
    "apply": "Merge only the selected platform fragment into your local settings.json; preserve unrelated settings. Restart Pi after tool removal."
  },
  "autoCompaction": {
    "package": "npm:pi-auto-compact@1.2.3",
    "repository": "https://github.com/Chasen-Liao/pi-auto-compact",
    "configFile": "pi-auto-compact.json",
    "config": {
      "threshold": 78
    },
    "summaryProvider": "deepseek",
    "summaryModel": "deepseek-v4-flash",
    "fallback": "Pi built-in compaction with the active session model; no fixed fallback model",
    "summaryMaxTokens": 8192,
    "nativeSettings": {
      "policy": "Preserve existing overrides; these are effective 0.99.2 defaults, not newly imposed settings",
      "enabled": true,
      "reserveTokens": 16384,
      "keepRecentTokens": 20000
    }
  },
  "repository": "https://github.com/zenenznze/pi-config-baseline.git",
  "purpose": "Non-secret Pi configuration baseline and recommended runtime composition. This repository is not a Pi Package and must not be installed by Pi.",
  "pi": {
    "defaultProvider": "openai-codex",
    "defaultModel": "gpt-6.1-sol",
    "defaultThinkingLevel": "low",
    "theme": "light",
    "hideThinkingBlock": true
  },
  "recommendedPackages": [
    {
      "id": "pi-skill-palette",
      "source": "npm:pi-skill-palette@2.2.0",
      "expectedCommands": [
        "skill"
      ]
    },
    {
      "id": "pi-auto-compact",
      "source": "npm:pi-auto-compact@1.2.3",
      "repository": "https://github.com/Chasen-Liao/pi-auto-compact",
      "expectedCommands": [
        "compact-threshold"
      ]
    },
    {
      "id": "pi-accounts",
      "source": "npm:@leo_aifirst/pi-accounts@1.0.0",
      "repository": "https://github.com/zenenznze/pi-accounts.git",
      "ref": "48a03b5a7188829f55b7fe08784c7f65bbf4be9e",
      "expectedCommands": [
        "accounts"
      ]
    },
    {
      "id": "pi-usage",
      "source": "npm:@leo_aifirst/pi-usage@1.0.0",
      "repository": "https://github.com/zenenznze/pi-usage.git",
      "ref": "c9c2c69f2f1076466017f3fbcb2792ea79ba42e3",
      "expectedCommands": [
        "usage",
        "fast",
        "accounts-usage"
      ]
    },
    {
      "id": "pi-subscription-image",
      "source": "npm:@specode/pi-subscription-image@1.1.1",
      "repository": "https://github.com/specode/pi-subscription-image",
      "expectedCommands": [
        "img",
        "subscription-image"
      ],
      "expectedTools": [
        "generate_image_with_subscription"
      ]
    },
    {
      "id": "pi-session-search",
      "source": "npm:pi-session-search@1.6.0",
      "expectedCommands": [
        "session-embeddings-setup",
        "session-sync",
        "session-reindex"
      ],
      "expectedTools": [
        "session_search",
        "session_list",
        "session_read"
      ],
      "expectedSkills": [
        "session-history"
      ]
    }
  ],
  "retiredPackages": [
    {
      "id": "sol-pi",
      "source": "git:github.com/NVlabs/SoL-Pi@d7ecfc089944f0d04b80122a0a9a6ca0d786f3d0",
      "reason": "Native Code Mode handles orchestration and selective results; large-log reduction and archived-observation recall are not needed by the current workload; independent Auto Compact retains long-session compaction."
    }
  ],
  "independentPlugins": [
    {
      "id": "pi-accounts",
      "repository": "https://github.com/zenenznze/pi-accounts.git",
      "ref": "48a03b5a7188829f55b7fe08784c7f65bbf4be9e",
      "releaseBranch": "main",
      "runtimeAssertions": [
        {
          "path": "src/account-menu.ts",
          "includes": [
            "Startup default accounts",
            "startup-toggle"
          ]
        }
      ],
      "npm": {
        "name": "@leo_aifirst/pi-accounts",
        "version": "1.0.0",
        "integrity": "sha512-wFsRyakkFfDOn1aBjhQBQxe/ILHvd8m/LQfq4klrkmwdymGZWOrOdYyjhbIuEnK+IUNBSyW+kP6wc0QcBA7/Hw=="
      }
    },
    {
      "id": "pi-usage",
      "repository": "https://github.com/zenenznze/pi-usage.git",
      "ref": "c9c2c69f2f1076466017f3fbcb2792ea79ba42e3",
      "integrations": [
        "accounts-usage"
      ],
      "runtimeAssertions": [
        {
          "path": "src/accounts-usage-integration/accounts-usage.ts",
          "includes": [
            "import(\"../query.js\")",
            "accountsModuleSpecifiers"
          ]
        }
      ],
      "releaseBranch": "main",
      "npm": {
        "name": "@leo_aifirst/pi-usage",
        "version": "1.0.0",
        "integrity": "sha512-V6CZvQOBPE5BxnHX0EO9qiGR+HZGV8rftNNTP4Av5m+zzcYvDd2xLHCE1aT9dfpFklo8bP/MysmOv8jgAlcbWQ=="
      }
    }
  ],
  "independentRuntimeExtensions": [
    {
      "id": "dedicated-compaction-model",
      "path": "~/.pi/agent/extensions/dedicated-compaction-model.ts",
      "provider": "deepseek",
      "model": "deepseek-v4-flash"
    }
  ],
  "forbiddenActiveSources": [
    "SoL-Pi",
    "per-pi-package",
    "pi-config-baseline as a Pi Package",
    "pi-extensions/packages/pi-accounts",
    "pi-extensions/packages/pi-accounts-usage",
    "pi-extensions/packages/pi-usage"
  ],
  "forbiddenProviders": [
    "sub2api-deepseek"
  ],
  "validation": {
    "readOnly": true,
    "baselineCheck": "node scripts/check-config-baseline.mjs --agent-dir ~/.pi/agent"
  },
  "secretsExcluded": true,
  "lastVerified": "2026-10-01"
}
